# Optional: deliver contact-form inquiries straight to your inbox through Resend (https://resend.com).
# Without these two values the form opens the visitor's email app with the inquiry pre-filled (mailto).
RESEND_API_KEY=
# A sender on a domain you have verified in Resend, e.g. "CodeVanta Labs <hello@yourdomain.com>"
CONTACT_FROM_EMAIL=
# Where inquiries go. Defaults to thecodevantalabs@gmail.com
CONTACT_TO_EMAIL=thecodevantalabs@gmail.com
